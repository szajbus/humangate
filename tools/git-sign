#!/usr/bin/env bash
# Usage: git-sign <branch>
#
# Re-signs the commits <branch> has on top of the base branch (main, or
# $HUMANGATE_BASE_BRANCH), in place - the base stays where it is - and moves
# stacked branches pointing into that range along with it. <branch> must be
# checked out in this worktree, with no uncommitted changes.
#
# Commits at the bottom of the range that already have a good signature are
# left alone. From the first unsigned commit up, everything is re-signed, signed
# or not: rewriting a commit changes the hash of every commit above it, which
# invalidates their signatures. If every commit is signed, nothing happens.
#
# On the base branch itself it re-signs only the commits not on origin yet
# (all of them in a new repository), never published history.
set -euo pipefail

if [ "${1:-}" = --help ]; then
  awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
  exit 0
fi

fail() { echo "git-sign: $*" >&2; exit 2; }

[ $# -eq 1 ] || fail "usage: git-sign <branch>"
branch=$1
current=$(git symbolic-ref --quiet --short HEAD || true)
[ "$branch" = "$current" ] || fail "works on the branch checked out here (${current:-detached HEAD}), not '$branch'"
[ -z "$(git status --porcelain --untracked-files=no)" ] || fail "the worktree has uncommitted changes"

base_branch=${HUMANGATE_BASE_BRANCH:-main}
if [ "$branch" = "$base_branch" ]; then
  if published=$(git rev-parse --quiet --verify "refs/remotes/origin/$branch"); then
    git merge-base --is-ancestor "$published" "$branch" ||
      fail "'$branch' has diverged from origin/$branch"
    range="$published..$branch"
    onto=("$published")
  else
    range=$branch
    onto=(--root)
  fi
else
  base=$(git merge-base "$base_branch" "$branch")
  range="$base..$branch"
  onto=("$base")
fi
[ -n "$(git rev-list "$range")" ] || fail "'$branch' has no commits on top of $base_branch"
[ -z "$(git rev-list --merges "$range")" ] || fail "'$branch' contains merge commits; only linear history is supported"

# The first commit without a good signature (G, or U for an unknown trust level).
first_unsigned=
while read -r status hash; do
  case $status in G | U) ;; *) first_unsigned=$hash; break ;; esac
done < <(git log --reverse --format='%G? %H' "$range")

if [ -z "$first_unsigned" ]; then
  echo "All commits of '$branch' on top of $base_branch are signed already."
  exit 0
fi

# Start the rebase at the parent of the first unsigned commit, keeping the signed
# commits below it as they are.
if parent=$(git rev-parse --quiet --verify "$first_unsigned^"); then
  case " $(git rev-list "$range" | tr '\n' ' ')" in
    *" $parent "*) onto=("$parent"); range="$parent..$branch" ;;
  esac
else
  onto=(--root)
  range=$branch
fi

echo "Re-signing:"
git log --reverse --format='%G? %h %s' "$range" | while read -r status rest; do
  case $status in G | U) echo "  $rest (signed, but on top of an unsigned commit)" ;; *) echo "  $rest" ;; esac
done
echo
exec git rebase --force-rebase --gpg-sign --update-refs "${onto[@]}"
