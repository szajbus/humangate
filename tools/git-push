#!/usr/bin/env bash
# Usage: git-push <branch> [<branch>...]
#
# Pushes existing local branches to origin - no force, so git itself
# refuses anything but a fast-forward or a new branch. Use git-push-with-force
# for a branch whose history was rewritten (after a rebase, say).
#
# Action: diff - the commits origin doesn't have yet, with their changes
set -euo pipefail

if [ "${1:-}" = --help ]; then
  awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
  exit 0
fi

fail() { echo "git-push: $*" >&2; exit 2; }

# The loop's "just look" actions, run for the person only: <tool> --action <name> <arg>...
ACTION=
if [ "${1:-}" = --action ]; then
  ACTION=${2:-}
  [ "$ACTION" = diff ] || fail "unknown action '$ACTION'"
  shift 2
  # Asked for by the loop when it shows the output on a terminal.
  git() { command git ${HUMANGATE_COLOR:+-c color.ui=always} "$@"; }
fi

[ $# -ge 1 ] || fail "usage: git-push <branch> [<branch>...]"
for branch in "$@"; do
  case "$branch" in -*) fail "not a branch name: '$branch'" ;; esac
  git show-ref --verify --quiet "refs/heads/$branch" || fail "no local branch '$branch'"
done

if [ "$ACTION" = diff ]; then
  for branch in "$@"; do
    echo "== $branch"
    if git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git log --reverse --stat -p "refs/remotes/origin/$branch..refs/heads/$branch"
    else
      git log --reverse --stat -p "refs/heads/$branch" --not --remotes=origin
    fi
  done
  exit 0
fi

exec git push origin "$@"
