#!/usr/bin/env bash
# Usage: git-push-with-force <branch> [<branch>...]
#
# Force-pushes (with lease) existing local branches to origin, replacing
# their history there - for a branch rewritten by a rebase. Never main or
# master; the lease refuses if origin moved since the last fetch.
#
# Action: diff - what the new history changes compared to origin's
set -euo pipefail

if [ "${1:-}" = --help ]; then
  awk 'NR == 1 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"
  exit 0
fi

fail() { echo "git-push-with-force: $*" >&2; exit 2; }

# The loop's "just look" actions, run for the person only: <tool> --action <name> <arg>...
ACTION=
if [ "${1:-}" = --action ]; then
  ACTION=${2:-}
  [ "$ACTION" = diff ] || fail "unknown action '$ACTION'"
  shift 2
  # Asked for by the loop when it shows the output on a terminal.
  git() { command git ${HUMANGATE_COLOR:+-c color.ui=always} "$@"; }
fi

[ $# -ge 1 ] || fail "usage: git-push-with-force <branch> [<branch>...]"
for branch in "$@"; do
  case "$branch" in
    main | master) fail "refusing to force-push $branch - use git-push" ;;
    -*) fail "not a branch name: '$branch'" ;;
  esac
  git show-ref --verify --quiet "refs/heads/$branch" || fail "no local branch '$branch'"
done

if [ "$ACTION" = diff ]; then
  for branch in "$@"; do
    echo "== $branch (origin's version -> yours)"
    git diff --stat "refs/remotes/origin/$branch" "refs/heads/$branch" -- 2>&1 || true
    git range-diff "refs/remotes/origin/$branch...refs/heads/$branch" 2>&1 || true
  done
  exit 0
fi

exec git push --force-with-lease origin "$@"
