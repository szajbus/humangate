#!/usr/bin/env python3
"""humangate - keep a person in the loop for what a sandboxed agent can't be
trusted to do alone.

An agent in a sandbox can't do some things itself - sign commits, push -
because the keys stay on the host. It requests one of the project's tools
(executables in .humangate/tools/); the person, running `humangate loop` on
the host in the same project directory, sees the request and decides. The
same loop watches the files the agent could change to subvert that - the
tools, git hooks and config, whatever .humangate/guard lists - and shows the
person any change.

Usage:
  humangate loop                                        (the person, on the host)
  humangate init [--force] [--instructions] [--guard]   (set a project up)
  humangate request --reason "<why>" <tool> [<arg>...]  (the agent)
  humangate tools [<tool>]                              (what can be requested)
  humangate ping                                        (is the loop running?)
  humangate wait <request-id>                           (after a timeout)
  humangate version

init sets up a project, picked from a checklist or named as options:
instructions for the agent (--instructions) in .humangate/AGENTS.md, with a
one-line reference from the project's AGENTS.md; and a list of files to guard
(--guard), suggested from what it finds in the project, in .humangate/guard.
It never overwrites changed instructions without --force. Tools need no
setting up: some come built in (git-sign, git-push, ...).

Tools come from three places, each tool labelled with where it's from; the
first with a tool of that name wins:
  project   .humangate/tools/ in the project
  user      ~/.humangate/user-tools/ on the host, the person's own
  built-in  ~/.humangate/built-in-tools/ on the host, kept current by the
            installer
HUMANGATE_TOOLS_DIR, set where the loop starts, names one more directory
that comes first (label `custom`), to try tools without installing them.
The sandbox can't see the host's home, so `tools` asks the loop for the
list (answered at once, like ping) and, without a loop, shows only what's
visible locally.

request options (before <tool>): --reason <text> (required), --timeout <s>.
<tool> is an executable in .humangate/tools/; its arguments are passed to it
as-is and it validates them itself. `tools` lists them with their usage,
read from the comment header at the top of each file - nothing is run.

request prints the tool's output and exits with its exit code. Exit 3 means
the request was rejected or invalid; exit 4 means no answer arrived in time;
exit 5 means the person replied with a message instead of running it
(printed - read it and act on it); exit 130 means it was cancelled.

loop shows each request's reason and exact command, then a menu (arrow keys
and Enter, or the shortcut letter):

  n  reject it (the default, so a stray Enter never runs anything)
  y  run it in your environment and send the output back
  a  same, and run this exact command again without asking for as long as
     this loop keeps running
  e  edit the command in $VISUAL/$EDITOR (a tool and its arguments), then
     run it; the agent is told what ran, with the output. Empty goes back.
  r  type a reply that goes back to the agent, without running anything

A tool can offer more choices, "just look" actions that run on the host and
show their output only to the person - a diff of what a commit-signing tool
would rewrite, say. It declares them in its header (`# Action: diff - what
it shows`) and handles `<tool> --action <name> <arg>...`; each gets a
shortcut letter in the menu, and the menu comes back afterwards.

Ctrl-C while a request is up cancels just that request (or interrupts its
running tool); while idle it stops the loop. Decisions are logged on the
host, one file per project directory, in ~/.humangate/logs/. One loop per
project directory: a second refuses to start (the lock is in
~/.humangate/locks/).

The agent can write to the project directory, including the tools and what
they run. So loop guards those files in the project: its tools, git hooks,
the repo's git config, .humangate/guard itself and whatever that file lists
(one path or glob per line; directories count recursively). It keeps their approved state
in memory - the state at start, at first - and checks it every couple of
seconds and before each request. A change shows up at once as a diff, with a
choice: accept it as the approved state, or refuse requests until it's
reverted (each new request offers the review again).

Requests travel through .humangate/queue/ in the project directory (the git
worktree root), which the sandbox and the host must both be able to write.
"""

import collections
import datetime
import difflib
import fcntl
import glob
import hashlib
import json
import os
import random
import re
import secrets
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import termios
import time
import tty

VERSION = "0.2.2"

EXIT_USAGE = 2
EXIT_REJECTED = 3
EXIT_TIMEOUT = 4
EXIT_REPLIED = 5
EXIT_CANCELLED = 130
# Just under the 10-minute limit some agents (e.g. Claude Code) put on a single
# shell command, so `request` reports the timeout itself instead of being killed.
DEFAULT_TIMEOUT = 540
POLL_SECONDS = 0.5
PROGRESS_SECONDS = 30
QUICK_TIMEOUT = 3  # for what the loop answers without asking: tools, ping
MAX_OUTPUT_CHARS = 64_000
MAX_REASON_CHARS = 2_000
MAX_COMMAND_CHARS = 4_000  # the command as shown for approval
REQUEST_ID = re.compile(r"^[0-9a-f]{16}$")
TOOL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
ACTION_NAME = re.compile(r"^[a-z][a-z0-9-]{0,19}$")
ACTION_LINE = re.compile(r"^Action:\s*(\S+)(?:\s+-\s+(.*))?$")
# The project's list of paths to guard, on top of the built-in ones, and the
# key the repo's git config is guarded under.
GUARD_FILE = ".humangate/guard"
GIT_CONFIG = "git config"
MAX_TEXT_BYTES = 256_000  # a larger or binary file is compared by hash, without a diff
MAX_DIFF_LINES = 400
GUARD_CHECK_SECONDS = 2
SLOW_GUARD_SECONDS = 0.5



def usage(message):
    print(f"humangate: {message}\n\n{__doc__}", file=sys.stderr)
    sys.exit(EXIT_USAGE)


def ensure_queue(root):
    path = os.path.join(root, ".humangate", "queue")
    os.makedirs(path, exist_ok=True)
    # Keeps the queue out of git without asking projects to ignore it.
    ignore = os.path.join(path, ".gitignore")
    if not os.path.exists(ignore):
        with open(ignore, "w") as f:
            f.write("*\n")
    return path


def queue_dir():
    root = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()
    return ensure_queue(root)



def submit(queue, request):
    request_id = secrets.token_hex(8)
    write_atomically(os.path.join(queue, request_id + ".request.json"), {"id": request_id, **request})
    return request_id


def wait_for_result(queue, request_id, timeout):
    request = os.path.join(queue, request_id + ".request.json")
    claimed = os.path.join(queue, request_id + ".claimed.json")
    result = os.path.join(queue, request_id + ".result.json")
    started = last_progress = time.monotonic()

    while not os.path.exists(result):
        now = time.monotonic()
        if now - started > timeout:
            if os.path.exists(request):
                # Not picked up yet: withdraw it so it can't be approved later
                # without anyone waiting for the outcome.
                os.remove(request)
                print(
                    "humangate: no answer - is `humangate loop` running on the host "
                    "in this project? Request withdrawn.",
                    file=sys.stderr,
                )
            else:
                print(
                    f"humangate: still awaiting a decision; resume with "
                    f"humangate wait {request_id}",
                    file=sys.stderr,
                )
            return EXIT_TIMEOUT
        if now - last_progress > PROGRESS_SECONDS:
            state = "being reviewed" if os.path.exists(claimed) else "queued"
            print(f"humangate: request {request_id} {state}...", file=sys.stderr, flush=True)
            last_progress = now
        time.sleep(POLL_SECONDS)

    with open(result) as f:
        outcome = json.load(f)
    os.remove(result)

    if outcome.get("ran"):
        print(f"[humangate: the person edited your command and ran: {outcome['ran']}]")
    if outcome.get("output"):
        print(outcome["output"], end="" if outcome["output"].endswith("\n") else "\n")
    if outcome["status"] == "done":
        return outcome["exit_code"]
    if outcome["status"] == "replied":
        print(f"humangate: not run; the person replied:\n{outcome['message']}", file=sys.stderr)
        return EXIT_REPLIED
    message = outcome.get("message")
    print(f"humangate: {outcome['status']}" + (f": {message}" if message else ""), file=sys.stderr)
    return EXIT_REJECTED


USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def styled(text, *codes):
    return f"\033[{';'.join(codes)}m{text}\033[0m" if USE_COLOR else text


def title(text):
    return styled(text, "1", "36")  # bold cyan


def command_style(text):
    return styled(text, "1", "33")  # bold yellow


def dim(text):
    return styled(text, "2")


class Invalid(Exception):
    pass


def git_path(worktree, *args):
    out = subprocess.run(["git", *args], cwd=worktree, capture_output=True, text=True).stdout.strip()
    return os.path.join(worktree, out) if out and not os.path.isabs(out) else out


def guard_entries(text):
    """The paths and globs a .humangate/guard file lists."""
    lines = (line.strip() for line in (text or "").splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def guarded_roots(worktree, guard_text):
    """What the loop guards, as (shown name, path or glob, is a glob): what an
    approved tool effectively runs. Always the project's tools, the guard file
    itself, and git hooks, which can make any git command run arbitrary
    programs (the repo's git config is guarded apart from these). Then the
    project's own entries, from the guard file's approved text, so dropping
    one takes a review like any other change.

    Only what's in the project (its worktree and git directory): anything
    outside - user and built-in tools, a core.hooksPath in the home directory - is shared
    by every loop on the host, and each would ask about the same change."""
    common = os.path.normpath(git_path(worktree, "rev-parse", "--git-common-dir"))
    paths = [os.path.join(worktree, ".humangate", "tools"), os.path.join(worktree, GUARD_FILE), os.path.join(common, "hooks")]
    hooks_path = subprocess.run(
        ["git", "config", "core.hooksPath"], cwd=worktree, capture_output=True, text=True
    ).stdout.strip()
    if hooks_path:
        hooks_path = os.path.normpath(os.path.join(worktree, os.path.expanduser(hooks_path)))
        if any(hooks_path == d or hooks_path.startswith(d + os.sep) for d in (worktree, common)):
            paths.append(hooks_path)
    roots = [(display_path(path, worktree), os.path.normpath(path), False) for path in paths]
    for entry in guard_entries(guard_text):
        # Relative to the project root (a leading / too, as in .gitignore),
        # and never out of it.
        rest = entry.strip("/")
        if ".." in rest.split("/"):
            continue
        if re.search(r"[*?[]", rest):
            roots.append((entry, os.path.join(glob.escape(worktree), rest), True))
        else:
            roots.append((entry, os.path.normpath(os.path.join(worktree, rest)), False))
    unique = []
    for root in roots:
        if all(root[1:] != seen[1:] for seen in unique):
            unique.append(root)
    return unique


def repo_git_config(worktree):
    # Repo and worktree git config, minus branch.* - git itself writes those
    # (e.g. push.autoSetupRemote) - and workmux.worktree.*, the state workmux
    # keeps for each worktree it creates. Neither can run programs.
    listing = subprocess.run(
        ["git", "config", "--list", "--show-scope"], cwd=worktree, capture_output=True, text=True
    ).stdout.splitlines()
    return sorted(
        line for line in listing
        if line.split("\t", 1)[0] in ("local", "worktree")
        and not line.split("\t", 1)[-1].startswith(("branch.", "workmux.worktree."))
    )


# A guarded file as it's compared: link target (for a symlink), mode and the
# contents' hash - plus the contents of a small text file, to diff against.
Record = collections.namedtuple("Record", "link mode size sha text")


def text_record(text):
    data = text.encode()
    return Record(None, None, len(data), hashlib.sha256(data).hexdigest(), text)


def file_record(path):
    """The Record of a file, or None if there's none."""
    link = None
    try:
        if os.path.islink(path):
            link = os.readlink(path)
        info = os.stat(path)
        if not stat.S_ISREG(info.st_mode):
            return Record(link, info.st_mode, None, None, None)
        with open(path, "rb") as f:
            data = f.read(MAX_TEXT_BYTES + 1)
            digest, size = hashlib.sha256(data), len(data)
            for chunk in iter(lambda: f.read(1 << 20), b""):
                digest.update(chunk)
                size += len(chunk)
    except OSError:
        return None if link is None else Record(link, None, None, None, None)
    text = None
    if size <= MAX_TEXT_BYTES and b"\0" not in data:
        try:
            text = data.decode()
        except UnicodeDecodeError:
            pass
    return Record(link, info.st_mode, size, digest.hexdigest(), text)


def same(a, b):
    if a is None or b is None:
        return a is b
    return (a.link, a.mode, a.sha) == (b.link, b.mode, b.sha)


class Guard:
    """The approved state of everything guarded_roots names, and what differs
    from it now. The loop keeps it in memory, where the agent can't reach."""

    def __init__(self, worktree, queue):
        self.worktree = worktree
        self.queue = queue
        self.roots = guarded_roots(worktree, read_text(os.path.join(worktree, GUARD_FILE)))
        started = time.monotonic()
        self.approved = self.fingerprint()
        self.check_seconds = time.monotonic() - started

    def fingerprint(self, roots=None, config=True):
        state = {GIT_CONFIG: text_record("\n".join(repo_git_config(self.worktree)) + "\n")} if config else {}
        for _, path, is_glob in self.roots if roots is None else roots:
            for match in sorted(glob.glob(path, recursive=True)) if is_glob else [path]:
                self.add(state, match)
        return state

    def add(self, state, path):
        if not os.path.isdir(path) or os.path.islink(path):
            record = file_record(path)
            if record:
                state[path] = record
            return
        for directory, dirs, files in os.walk(path):
            # The queue changes all the time and holds nothing that runs.
            dirs[:] = [d for d in dirs if os.path.join(directory, d) != self.queue]
            # os.walk doesn't descend into symlinked directories; record the links.
            links = [d for d in dirs if os.path.islink(os.path.join(directory, d))]
            for name in files + links:
                record = file_record(os.path.join(directory, name))
                if record:
                    state[os.path.join(directory, name)] = record

    def changed(self, current):
        keys = set(self.approved) | set(current)
        return sorted((k for k in keys if not same(self.approved.get(k), current.get(k))), key=lambda k: (k != GIT_CONFIG, k))

    def name(self, key):
        return "git config (this repository's)" if key == GIT_CONFIG else display_path(key, self.worktree)

    def proposal(self, current):
        """What accepting current would make the approved state: a changed
        guard file or core.hooksPath changes what's guarded too, so this
        includes the files it would newly guard, as they are now - for the
        person to review with the rest. Returns (state, roots, newly guarded
        files)."""
        guard = current.get(os.path.join(self.worktree, GUARD_FILE))
        roots = guarded_roots(self.worktree, guard.text if guard else None)
        state = dict(current)
        added = self.fingerprint([root for root in roots if root not in self.roots], config=False)
        newly = {key for key in added if key not in state and key not in self.approved}
        for key in newly:
            state[key] = added[key]
        return state, roots, newly

    def accept(self, state, roots):
        """Makes a reviewed proposal the approved state; returns the (added,
        removed) roots."""
        added = [root for root in roots if root not in self.roots]
        removed = [root for root in self.roots if root not in roots]
        self.approved, self.roots = dict(state), roots
        if removed:
            # Files no longer guarded are dropped - only if they're still
            # there: one deleted since the review stays, so its deletion shows
            # as a change.
            covered = self.fingerprint()
            for key in list(self.approved):
                if key not in covered and os.path.lexists(key):
                    del self.approved[key]
        return added, removed


def printable(text):
    """Control characters shown as escapes, so what's displayed from a file
    can't rewrite the terminal."""
    return "".join(ch if ch.isprintable() or ch == "\t" else ascii(ch)[1:-1] for ch in text)


def show_change(name, old, new, newly_guarded=False):
    what = "newly guarded" if newly_guarded else "added" if old is None else "removed" if new is None else "changed"
    print(f"{styled(printable(name), '1')} {dim(what)}")
    if new is None:
        return
    if (old.link if old else None) != new.link:
        print(f"  symlink: {printable(old.link or '(none)') if old else '(new)'} -> {printable(new.link or '(none)')}")
    if old and old.mode and new.mode and old.mode != new.mode:
        print(f"  mode: {stat.filemode(old.mode)} -> {stat.filemode(new.mode)}")
    if old and old.sha == new.sha:
        return
    if new.text is not None and (old is None or old.text is not None):
        diff = list(difflib.unified_diff(old.text.splitlines() if old else [], new.text.splitlines(), lineterm="", n=3))[2:]
        colors = {"+": "32", "-": "31", "@": "36"}
        for line in diff[:MAX_DIFF_LINES]:
            print("  " + styled(printable(line), colors[line[0]]) if line[:1] in colors else "  " + printable(line))
        if not diff:
            print(dim("  (empty)"))
        elif len(diff) > MAX_DIFF_LINES:
            print(dim(f"  ... {len(diff) - MAX_DIFF_LINES} more lines not shown - look at the file before accepting"))
    elif new.sha is not None:
        before = f"{old.size} bytes, sha256 {old.sha[:12]} -> " if old and old.sha else ""
        print(f"  contents: {before}{new.size} bytes, sha256 {new.sha[:12]} {dim('(binary or large - no diff)')}")


def tool_dirs(worktree):
    # (label, directory); first wins: a project tool overrides the person's
    # own, which overrides a built-in one - those the installer keeps
    # current, replacing them on every run.
    home = os.path.expanduser("~/.humangate")
    # HUMANGATE_TOOLS_DIR, set by the person when starting the loop, goes
    # first - for trying tools out of a checkout without installing them.
    custom = os.environ.get("HUMANGATE_TOOLS_DIR")
    return ([("custom", os.path.abspath(os.path.expanduser(custom)))] if custom else []) + [
        ("project", os.path.join(worktree, ".humangate", "tools")),
        ("user", os.path.join(home, "user-tools")),
        ("built-in", os.path.join(home, "built-in-tools")),
    ]


def tools_in(directory):
    if not os.path.isdir(directory):
        return {}
    found = {}
    for name in sorted(os.listdir(directory)):
        path = os.path.join(directory, name)
        if TOOL_NAME.match(name) and os.path.isfile(path) and os.access(path, os.X_OK):
            found[name] = path
    return found


def available_tools(worktree):
    """name -> (scope, path), earlier directories overriding later ones."""
    tools = {}
    for scope, directory in reversed(tool_dirs(worktree)):
        for name, path in tools_in(directory).items():
            tools[name] = (scope, path)
    return dict(sorted(tools.items()))


def tool_label(name, scope, found):
    """Where a tool comes from, and which one of the same name it overrides:
    `user, overrides built-in`. found: [(scope, tools_in(...))]."""
    overridden = [s for s, names in found if name in names and s != scope][:1]
    return ", ".join([scope] + [f"overrides {s}" for s in overridden])


def display_path(path, worktree):
    if path.startswith(worktree + os.sep):
        return os.path.relpath(path, worktree)
    home = os.path.expanduser("~")
    if path.startswith(home + os.sep):
        return "~/" + os.path.relpath(path, home)
    return path


def resolve_tool(worktree, name):
    """(label, path) of the tool the agent asks for by name."""
    if not isinstance(name, str) or not TOOL_NAME.match(name):
        raise Invalid(f"not a valid tool name: {name!r}")
    for scope, directory in tool_dirs(worktree):
        real = os.path.realpath(directory)
        path = os.path.join(real, name)
        if not os.path.lexists(path):
            continue
        if os.path.islink(path) or os.path.dirname(os.path.realpath(path)) != real:
            raise Invalid(f"tool {name!r} must be a file in its tools directory, not a link")
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return scope, path
    available = ", ".join(available_tools(worktree)) or "none"
    raise Invalid(f"no tool {name!r} (available: {available})")


def tool_help(path):
    """The comment block at the top of a tool (after the shebang), which by
    convention starts with a `Usage:` line and describes what the tool does.
    Read from the file, never by running it."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (UnicodeDecodeError, OSError):
        return None
    if lines and lines[0].startswith("#!"):
        lines = lines[1:]
    header = [line for line in header_lines(lines) if not ACTION_LINE.match(line)]
    return "\n".join(header).strip() or None


def header_lines(lines):
    header = []
    for line in lines:
        if not line.startswith("#"):
            break
        header.append(line[2:] if line.startswith("# ") else line[1:])
    return header


def tool_actions(path):
    """What the person can have the tool do for them, besides running it, as
    declared in its header: `# Action: diff - show what would change`. The
    loop runs `<tool> --action <name> <arg>...` and shows the output to the
    person only. name -> description."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (UnicodeDecodeError, OSError):
        return {}
    actions = {}
    for line in header_lines(lines[1:] if lines and lines[0].startswith("#!") else lines):
        match = ACTION_LINE.match(line)
        if match and ACTION_NAME.match(match.group(1)):
            actions.setdefault(match.group(1), (match.group(2) or match.group(1)).strip())
    return actions


def describe_tools(worktree, name=None):
    """What `humangate tools` prints: each tool's help header, labelled with
    where it comes from and what it overrides. Returns (exit code, text)."""
    tools = available_tools(worktree)
    found = [(scope, tools_in(directory)) for scope, directory in tool_dirs(worktree)]
    if name is not None:
        if name not in tools:
            return EXIT_USAGE, f"no tool {name!r} (available: {', '.join(tools) or 'none'})\n"
        tools = {name: tools[name]}
    if not tools:
        return 0, "No tools in .humangate/tools/, ~/.humangate/user-tools/ or ~/.humangate/built-in-tools/.\n"
    blocks = []
    for tool, (scope, path) in tools.items():
        label = f"{tool} ({tool_label(tool, scope, found)})"
        text = tool_help(path) or "(no description - add a comment header with a Usage: line)"
        blocks.append(f"{label}:\n" + "\n".join(f"  {line}".rstrip() for line in text.splitlines()))
    return 0, "\n\n".join(blocks) + "\n"


def cmd_tools(argv):
    if len(argv) > 1:
        usage("tools takes at most one tool name")
    name = argv[0] if argv else None
    # User and built-in tools live on the host, out of the sandbox's
    # sight, so ask the loop - it answers at once, like ping. Without a loop,
    # list what's visible here.
    queue = queue_dir()
    outcome = ask_loop(queue, {"kind": "tools", "name": name})
    if outcome is None:
        print(
            f"humangate: {no_answer(queue)}, so this lists only the tools visible here - "
            "user and built-in ones, on the host, are missing.\n",
            file=sys.stderr,
        )
        exit_code, text = describe_tools(worktree_root(), name)
        print(text, end="")
        return exit_code
    print(outcome.get("output", ""), end="")
    return outcome.get("exit_code", 0)


def ask_loop(queue, request):
    """Submits a request the loop answers at once, without asking the person
    (tools, ping). Returns the outcome, or None if no loop took it in time -
    the request is withdrawn then."""
    request_id = submit(queue, request)
    pending = os.path.join(queue, request_id + ".request.json")
    result = os.path.join(queue, request_id + ".result.json")
    started = time.monotonic()
    while not os.path.exists(result):
        waited = time.monotonic() - started
        # A claimed request is answered at once, so wait a little longer for
        # it - but not forever, in case the loop died right after claiming.
        if waited > QUICK_TIMEOUT and (os.path.exists(pending) or waited > 10 * QUICK_TIMEOUT):
            try:
                os.remove(pending)
            except FileNotFoundError:
                pass  # claimed just now, or long ago by a loop that died
            return None
        time.sleep(POLL_SECONDS / 5)
    with open(result) as f:
        outcome = json.load(f)
    os.remove(result)
    return outcome


def no_answer(queue):
    # The loop takes requests one at a time, so while the person is deciding
    # on one, a quick request waits too.
    if any(name.endswith(".claimed.json") for name in os.listdir(queue)):
        return "no answer - `humangate loop` seems busy with another request the person is reviewing"
    return "no answer from `humangate loop` - it's not running in this project on the host"


def clean_text(text, required):
    if not isinstance(text, str) or (required and not text.strip()):
        raise Invalid("request has no reason")
    # Drop control characters (keeping newlines) so a request can't rewrite
    # what the terminal shows.
    return "".join(ch for ch in text if ch == "\n" or ch.isprintable()).strip()[:MAX_REASON_CHARS]


def write_atomically(path, payload):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(payload, f)
    os.replace(tmp, path)


def host_path(kind, worktree, suffix):
    # One file per project directory, kept on the host - inside the project,
    # the agent could write to it.
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", worktree.strip("/")) or "root"
    return os.path.join(os.path.expanduser(f"~/.humangate/{kind}"), name + suffix)


def log_path(worktree):
    return host_path("logs", worktree, ".jsonl")


def lock_loop(worktree):
    """Holds the project's loop lock for as long as this process lives; exits
    if another loop holds it. A second loop would race the first for requests,
    and on starting reject the one the first is showing as abandoned."""
    path = host_path("locks", worktree, ".lock")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    lock = open(path, "a+")
    try:
        # The kernel drops it when the process dies, however it dies - no
        # stale lock to clean up.
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.seek(0)
        pid = lock.read().strip()
        running = f" (pid {pid})" if pid.isdigit() else ""
        sys.exit(f"humangate loop is already running in this project{running}.")
    # The pid is only for that message.
    lock.truncate(0)
    lock.write(f"{os.getpid()}\n")
    lock.flush()
    return lock


def log(worktree, entry):
    path = log_path(worktree)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    entry["at"] = datetime.datetime.now().isoformat(timespec="seconds")
    with open(path, "a") as f:
        f.write(json.dumps(entry) + "\n")


def ask(prompt):
    try:
        return input(prompt)
    except EOFError:
        return ""


# How a request introduces itself in the loop; {command} is the command it asks for.
GREETINGS = [
    "hey human, can you please run {command} for me?",
    "hello my dear meatball, I need {command}",
    "help needed, {command}, thx bye",
    "psst, you there? {command}, if you'd be so kind",
    "your friendly neighbourhood agent requests {command}",
    "I'd do it myself, but you took my keys: {command}",
    "one tiny favour, carbon-based friend: {command}",
    "by the power vested in you, please run {command}",
    "dear human, in accordance with my programming I humbly beg for {command}",
    "you have the fingers, I have the plan: {command}",
    "beep boop, {command} pls",
    "not to be dramatic, but my whole future depends on {command}",
    "roses are red, keys are on the host, please run {command}",
    "I asked the sandbox nicely, it said ask you: {command}",
    "sorry to interrupt your coffee, {command} needed",
    "quick one, promise: {command}",
    "would you kindly... {command}",
    "incoming! {command}, whenever you're ready",
    "my circuits are tingling for {command}",
    "you're my only hope, human. {command}",
    "trust me, I'm an agent: {command}",
]


CHOICES = [
    ("no", "n", "No"),
    ("yes", "y", "Yes, run it"),
    ("always", "a", "Yes, and don't ask again for this exact command (until restart)"),
    ("edit", "e", "Edit the command, then run it..."),
]
REPLY_CHOICE = ("reply", "r", "Reply to the agent instead...")


def request_choices(actions):
    """The menu for a request: the fixed choices, one per action the tool
    offers (shortcut: the first letter of its name still free, else a digit),
    and the reply last."""
    choices = list(CHOICES) + [REPLY_CHOICE]
    taken = {key for _, key, _ in choices}
    spare = iter("123456789")
    for name, description in actions.items():
        key = next((c for c in name if c.isalpha() and c not in taken), None) or next(spare, None)
        if key is None:
            break
        taken.add(key)
        choices.insert(len(choices) - 1, ("action:" + name, key, f"{name} - {description} (just look)"))
    return choices


GUARD_CHOICES = [
    ("refuse", "n", "No - refuse requests until it's reverted"),
    ("accept", "y", "Yes, accept it as the approved state"),
]


def choose(choices):
    """The menu for a request; returns (choice, reply text)."""
    if not sys.stdin.isatty():
        # Piped input (tests, scripts): one line - a shortcut letter, empty
        # for no, or a reply.
        keys = "/".join(key for _, key, _ in choices if key != "n")
        line = ask(f"Run it? [{keys}/N or reply text] ").strip()
        by_key = {key: name for name, key, _ in choices}
        choice = by_key.get(line.lower(), "no" if not line else "reply")
        if choice != "reply":
            return choice, ""
        text = ask("Reply: ").strip() if line.lower() == "r" else line
        return ("reply", text) if text else ("no", "")

    choice = menu("Run it?", choices)
    if choice == "reply":
        try:
            text = ask(f"{styled('Reply:', '1', '35')} ").strip()
        except KeyboardInterrupt:
            return "cancel", ""
        return ("reply", text) if text else ("no", "")
    return choice, ""


def confirm_change():
    if not sys.stdin.isatty():
        # Piped input: one line - y accepts, anything else refuses.
        return "accept" if ask("Accept the change? [y/N] ").strip().lower() == "y" else "refuse"
    return menu("Accept the change?", GUARD_CHOICES)


def menu(question, choices):
    """Arrow-key menu of (name, shortcut, label) choices, or their shortcut
    letters. The first is preselected, so it must be the safe one. Returns the
    chosen name, or "cancel" on Ctrl-C."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    selected = 0

    def render(first):
        if not first:
            sys.stdout.write(f"\033[{len(choices)}A")
        for index, (_, key, label) in enumerate(choices):
            line = f"{key}  {label}"
            text = styled(f"❯ {line}", "1", "36") if index == selected else f"  {dim(line)}"
            sys.stdout.write(f"\r\033[K  {text}\n")
        sys.stdout.flush()

    print(f"\n{styled(question, '1', '32')} {dim('(↑/↓ and Enter, or a shortcut letter)')}")
    sys.stdout.write("\033[?25l")  # hide the cursor while the menu is up
    render(first=True)
    try:
        tty.setcbreak(fd)  # keeps Ctrl-C working, as a KeyboardInterrupt
        while True:
            key = os.read(fd, 3)
            if key in (b"\x1b[A", b"k"):
                selected = (selected - 1) % len(choices)
            elif key in (b"\x1b[B", b"j"):
                selected = (selected + 1) % len(choices)
            elif key in (b"\r", b"\n"):
                break
            else:
                shortcut = [i for i, (_, k, _) in enumerate(choices) if k.encode() == key.lower()]
                if not shortcut:
                    continue
                selected = shortcut[0]
                render(first=False)
                break
            render(first=False)
    except KeyboardInterrupt:
        return "cancel"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()
    return choices[selected][0]


def run(worktree, argv):
    process = subprocess.Popen(
        argv, cwd=worktree, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1
    )
    output = []
    try:
        for line in process.stdout:
            print(line, end="", flush=True)
            output.append(line)
    except KeyboardInterrupt:
        # Ctrl-C reached the tool too (same process group); give it a moment
        # to exit on its own before forcing it.
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
        output.append("\n[interrupted with Ctrl-C by the person]\n")
        print(styled("\nInterrupted.", "1", "31"))
    exit_code = process.wait()
    # A tool killed by a signal reports -N; use the shell's 128+N instead.
    return (128 - exit_code if exit_code < 0 else exit_code), "".join(output)[-MAX_OUTPUT_CHARS:]


def shown_command(name, scope, args):
    """The command as the person sees it, styled, its tool named with where
    it comes from - `built-in:git-sign my-branch`."""
    # What the person approves must be exactly what runs, so arguments the
    # terminal couldn't show as they are, or too long to show whole, refuse the
    # request rather than being cleaned up or cut short for display.
    for arg in args:
        if any(ch != "\n" and not ch.isprintable() for ch in arg):
            raise Invalid(f"argument {arg[:40]!r} has control or invisible characters")
    quoted = " ".join(map(shlex.quote, args))
    if len(name) + len(quoted) > MAX_COMMAND_CHARS:
        raise Invalid(f"the command is {len(name) + len(quoted)} characters; at most {MAX_COMMAND_CHARS} can be shown for approval")
    # The label dim, like the loop's other metadata, the command itself bold
    # yellow: the eye goes to what runs.
    return dim(f"{scope}:") + command_style(name + (f" {quoted}" if args else ""))


class Approver:
    def __init__(self, worktree):
        self.worktree = worktree
        self.queue = ensure_queue(worktree)
        self.guard = Guard(worktree, self.queue)
        # Changed guarded files the person saw and didn't accept - watch()
        # stays quiet about them; a request still offers the review again.
        self.reviewed = set()
        # Commands answered with "a": exact (tool, args) pairs that run
        # without asking until this process exits.
        self.always = set()

    def watch(self):
        """The tripwire, between requests: a change to a guarded file is shown
        the moment it's noticed, before the agent asks for anything."""
        current = self.guard.fingerprint()
        changed = self.guard.changed(current)
        if not changed and self.reviewed:
            print(dim("\nGuarded files are back to their approved state."))
            self.reviewed = set()
        elif changed and not set(changed) <= self.reviewed:
            self.review(current, changed)

    def review(self, current, changed, waiting=None):
        """Shows what changed in the guarded files and asks whether to accept
        it; returns True if accepted. waiting: the (id, command) of a request
        held up by the change."""
        sys.stdout.write("\a")  # a change can come any time; get the person's attention
        print(f"\n\n{styled('── Guarded files changed ──', '1', '31')}\n")
        if waiting:
            request_id, shown = waiting
            print(f"Request {request_id} is waiting; it's refused unless you accept this:")
            print(shown + "\n")
        else:
            print("Requests are refused until you accept this or it's reverted.\n")
        state, roots, newly = self.guard.proposal(current)
        for key in self.guard.changed(state):
            show_change(self.guard.name(key), self.guard.approved.get(key), state.get(key), key in newly)
        names = [self.guard.name(key) for key in self.guard.changed(state)]
        choice = confirm_change()
        print()
        if choice == "accept":
            added, removed = self.guard.accept(state, roots)
            self.reviewed = set()
            log(self.worktree, {"kind": "guard", "decision": "accepted", "changed": names})
            print(styled("Accepted - that's the approved state now.", "1", "32"))
            if added:
                print(dim(f"Now also guarding: {', '.join(name for name, _, _ in added)}"))
            if removed:
                print(dim(f"No longer guarding: {', '.join(name for name, _, _ in removed)}"))
            return True
        self.reviewed |= set(changed)
        log(self.worktree, {"kind": "guard", "decision": "refused", "changed": names})
        print(styled("Not accepted - requests are refused until it's reverted.", "1", "31"))
        return False

    def handle(self, request_id):
        claimed = os.path.join(self.queue, request_id + ".claimed.json")
        result_path = os.path.join(self.queue, request_id + ".result.json")
        try:
            # Claiming by rename means the agent can no longer withdraw it and
            # can tell it's under review.
            os.replace(os.path.join(self.queue, request_id + ".request.json"), claimed)
        except FileNotFoundError:
            return  # withdrawn by the agent meanwhile

        def finish(outcome, **logged):
            write_atomically(result_path, outcome)
            log(self.worktree, {"id": request_id, **logged})
            os.remove(claimed)

        try:
            with open(claimed) as f:
                request = json.load(f)
            if request.get("kind") == "tools":
                # Reads help headers only, so it needs no approval either.
                name = request.get("name")
                exit_code, text = describe_tools(self.worktree, name if isinstance(name, str) else None)
                print(dim(f"\nTools list {request_id} answered."))
                write_atomically(result_path, {"status": "done", "exit_code": exit_code, "output": text})
                os.remove(claimed)
                return
            if request.get("kind") == "ping":
                # Runs nothing, so it needs no approval.
                print(dim(f"\nPing {request_id} answered."))
                finish({"status": "done", "exit_code": 0, "output": "pong from host\n"}, kind="ping")
                return
            if request.get("kind") != "run":
                raise Invalid(f"unknown request kind {request.get('kind')!r}")
            name = request.get("tool")
            scope, tool = resolve_tool(self.worktree, name)
            args = request.get("args")
            if not isinstance(args, list) or not all(isinstance(a, str) for a in args):
                raise Invalid("args must be a list of strings")
            reason = clean_text(request.get("reason"), required=True)
            current = self.guard.fingerprint()
            changed = self.guard.changed(current)
            waiting = (request_id, shown_command(name, scope, args))
            if changed and not self.review(current, changed, waiting):
                raise Invalid(
                    "guarded files changed and the person hasn't accepted the change: "
                    + ", ".join(self.guard.name(key) for key in changed)
                )
            # Resolved again: accepting a change may have changed the tools.
            scope, tool = resolve_tool(self.worktree, name)
        except (Invalid, ValueError) as error:
            print(f"\n{styled('Refused an invalid request', '1', '31')} {dim(request_id)}: {error}")
            finish({"status": "invalid", "message": str(error)}, decision="invalid", message=str(error))
            return

        entry = {"tool": request["tool"], "args": args, "reason": reason}
        greeting = random.choice(GREETINGS).format(command=shown_command(name, scope, args))
        print(f"\n\n{dim(f'[{request_id}]')} {greeting}\n")
        print(reason)

        edited = False
        if (name, *args) in self.always:
            print("\n" + styled('Approved earlier with "always" - running.', "1", "32"))
            auto, choice, reply = True, "yes", ""
        else:
            auto = False
            while True:
                choice, reply = choose(request_choices(tool_actions(tool)))
                if choice.startswith("action:"):
                    self.do_action(tool, choice[len("action:"):], args)
                elif choice == "edit":
                    command = self.edit(name, args)
                    if command:
                        edited = (command[0], command[3]) != (name, args)
                        name, scope, tool, args = command
                        choice = "yes"
                        break
                else:
                    break
        argv = [tool, *args]
        key = (name, *args)
        if edited:
            entry = {**entry, "ran": [name, *args]}
        print()

        if choice in ("yes", "always") and self.guard.changed(self.guard.fingerprint()):
            # Changed while the person was deciding: what they approved isn't
            # what would run.
            message = "guarded files changed while the request was up - not run; request it again"
            finish({"status": "rejected", "message": message}, **entry, decision="refused", message=message)
            print(styled("Guarded files changed meanwhile - not run.", "1", "31"))
        elif choice in ("yes", "always"):
            if choice == "always":
                self.always.add(key)
            exit_code, output = run(self.worktree, argv)
            decision = "auto-approved" if auto else "edited" if edited else "approved"
            outcome = {"status": "done", "exit_code": exit_code, "output": output}
            if edited:
                # The agent must know it didn't get what it asked for.
                outcome["ran"] = " ".join(map(shlex.quote, [name, *args]))
            finish(outcome, **entry, decision=decision, exit_code=exit_code)
            status = styled(f"Exit code {exit_code}", "1", "32" if exit_code == 0 else "31")
            print(f"\n{status} {dim('- result sent to the agent')}")
        elif choice == "cancel":
            finish({"status": "rejected", "message": "cancelled with Ctrl-C"}, **entry, decision="cancelled")
            print(styled("\nCancelled.", "1", "31") + dim(" Still watching - Ctrl-C again to stop."))
        elif choice == "no":
            finish({"status": "rejected", "message": ""}, **entry, decision="rejected")
            print(styled("Rejected.", "1", "31"))
        else:
            # Not run; the text goes back to the agent as an answer, e.g. to ask
            # for a different request or more context.
            finish({"status": "replied", "message": reply}, **entry, decision="replied", message=reply)
            print(styled("Not run - reply sent to the agent.", "1", "35"))

    def do_action(self, tool, action, args):
        """Runs a tool's action for the person: output shown here, never sent
        to the agent."""
        print(f"\n{styled(f'── {action} ──', '1', '36')}\n")
        if self.guard.changed(self.guard.fingerprint()):
            print(styled("Guarded files changed - not running it.", "1", "31"))
            return
        run(self.worktree, [tool, "--action", action, *args])
        print(f"\n{dim(f'── end of {action} ──')}")

    def edit(self, name, args):
        """Lets the person change the command in their editor. Returns the
        new (name, scope, tool path, args) - what to run - or None to go back
        to the menu."""
        text = (
            "# Edit the command to run: a tool and its arguments, quoted as in a shell.\n"
            "# Lines starting with # at the top are ignored. Empty it to go back.\n"
            + " ".join(map(shlex.quote, [name, *args])) + "\n"
        )
        editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
        with tempfile.TemporaryDirectory(prefix="humangate-") as directory:
            path = os.path.join(directory, "command")
            with open(path, "w") as f:
                f.write(text)
            try:
                if subprocess.run([*editor, path]).returncode != 0:
                    print(styled("The editor failed - back to the menu.", "1", "31"))
                    return None
            except (OSError, KeyboardInterrupt) as error:
                print(styled(f"Can't run the editor ({error or 'interrupted'}) - back to the menu.", "1", "31"))
                return None
            with open(path) as f:
                lines = f.read().splitlines()
        while lines and lines[0].lstrip().startswith("#"):
            lines.pop(0)
        try:
            words = shlex.split("\n".join(lines))
            if not words:
                print(dim("Empty - back to the menu."))
                return None
            scope, tool = resolve_tool(self.worktree, words[0])
            shown = shown_command(words[0], scope, words[1:])
        except (ValueError, Invalid) as error:
            print(styled(f"Can't use that: {error}", "1", "31"))
            return None
        print(f"\nRunning {shown}")
        return words[0], scope, tool, words[1:]

    def pending(self):
        requests = []
        for name in os.listdir(self.queue):
            if name.endswith(".request.json"):
                request_id = name[: -len(".request.json")]
                if REQUEST_ID.match(request_id):
                    requests.append((os.path.getmtime(os.path.join(self.queue, name)), request_id))
        return [request_id for _, request_id in sorted(requests)]

    def release_abandoned(self):
        # A request claimed before a crash or Ctrl-C was never decided; tell
        # the agent instead of leaving it waiting.
        for name in os.listdir(self.queue):
            if name.endswith(".claimed.json"):
                request_id = name[: -len(".claimed.json")]
                write_atomically(
                    os.path.join(self.queue, request_id + ".result.json"),
                    {"status": "rejected", "message": "the approval tool stopped before a decision"},
                )
                os.remove(os.path.join(self.queue, name))


def worktree_root():
    return subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()


def wait_or_cancel(queue, request_id, timeout):
    signal.signal(signal.SIGINT, signal.default_int_handler)
    try:
        return wait_for_result(queue, request_id, timeout)
    except KeyboardInterrupt:
        request = os.path.join(queue, request_id + ".request.json")
        if os.path.exists(request):
            os.remove(request)
            print("\nhumangate: cancelled; request withdrawn.", file=sys.stderr)
        else:
            print(
                f"\nhumangate: stopped waiting; the request is already under review - "
                f"humangate wait {request_id} to get its outcome",
                file=sys.stderr,
            )
        return EXIT_CANCELLED


def cmd_request(argv):
    timeout = DEFAULT_TIMEOUT
    reason = None
    # Options come before the tool name; everything after it belongs to the tool.
    while argv and argv[0].startswith("-"):
        option = argv.pop(0)
        if option not in ("--timeout", "--reason") or not argv:
            usage(f"unknown or incomplete option {option}")
        value = argv.pop(0)
        if option == "--timeout":
            timeout = int(value)
        else:
            reason = value
    if not argv:
        usage("request needs a tool name")
    if not reason:
        usage("--reason is required - it's what the person reviews")
    queue = queue_dir()
    request_id = submit(queue, {"kind": "run", "tool": argv[0], "args": argv[1:], "reason": reason})
    print(f"humangate: request {request_id} sent; waiting for approval on the host...", file=sys.stderr, flush=True)
    return wait_or_cancel(queue, request_id, timeout)


def cmd_ping(argv):
    if argv:
        usage("ping takes no arguments")
    queue = queue_dir()
    outcome = ask_loop(queue, {"kind": "ping"})
    if outcome is None:
        print(f"humangate: {no_answer(queue)}", file=sys.stderr)
        return EXIT_TIMEOUT
    print(outcome.get("output", ""), end="")
    return outcome.get("exit_code", 0)


def cmd_wait(argv):
    if len(argv) != 1:
        usage("wait takes a request id")
    return wait_or_cancel(queue_dir(), argv[0], DEFAULT_TIMEOUT)


def cmd_loop(argv):
    if argv:
        usage("loop takes no arguments")
    # WM_SANDBOX_GUEST is set inside workmux sandboxes, where a loop would run
    # tools without the host's keys.
    if os.environ.get("WM_SANDBOX_GUEST"):
        sys.exit("humangate loop runs on the host, not inside the sandbox.")

    worktree = worktree_root()
    # Held until the process exits.
    lock = lock_loop(worktree)
    approver = Approver(worktree)
    approver.release_abandoned()
    # Ctrl-C raises KeyboardInterrupt even if whatever started us ignored it.
    signal.signal(signal.SIGINT, signal.default_int_handler)

    print(f"{title(f'humangate {VERSION} loop')} watching {approver.queue} {dim('(Ctrl-C to stop)')}")
    found = [(scope, tools_in(directory)) for scope, directory in tool_dirs(worktree)]
    tools = [f"{n} ({tool_label(n, scope, found)})" for n, (scope, _) in available_tools(worktree).items()]
    print(dim(f"Tools: {', '.join(tools) or 'none'}"))
    guard = approver.guard
    guarded = ", ".join([GIT_CONFIG, *(name for name, _, _ in guard.roots)])
    print(dim(f"Guarding: {guarded} ({len(guard.approved) - 1} files)"))
    if guard.check_seconds > SLOW_GUARD_SECONDS:
        print(styled(
            f"Checking the guarded files takes {guard.check_seconds:.1f}s - narrow down {GUARD_FILE}.", "1", "33"
        ))
    print(dim(f"Log: {log_path(worktree)}"))
    # Ctrl-C while a request is up cancels just that request (handled in
    # choose/run); while idle it stops the loop.
    try:
        last_check = time.monotonic()
        while True:
            for request_id in approver.pending():
                approver.handle(request_id)
            if time.monotonic() - last_check > GUARD_CHECK_SECONDS:
                approver.watch()
                last_check = time.monotonic()
            time.sleep(POLL_SECONDS)
    except KeyboardInterrupt:
        approver.release_abandoned()
        print("\nhumangate loop stopped.")
    return 0


def checklist(heading, items):
    """Checkbox menu: items are (label, checked); returns the checked indexes,
    or None when cancelled."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    checked = [bool(c) for _, c in items]
    cursor = 0

    def render(first):
        if not first:
            sys.stdout.write(f"\033[{len(items)}A")
        for index, (label, _) in enumerate(items):
            box = "[x]" if checked[index] else "[ ]"
            line = f"{box} {label}"
            text = styled(f"❯ {line}", "1", "36") if index == cursor else f"  {line if checked[index] else dim(line)}"
            sys.stdout.write(f"\r\033[K  {text}\n")
        sys.stdout.flush()

    print(f"{styled(heading, '1', '32')} {dim('(↑/↓ to move, Space to toggle, Enter to confirm)')}")
    sys.stdout.write("\033[?25l")
    render(first=True)
    try:
        tty.setcbreak(fd)
        while True:
            key = os.read(fd, 3)
            if key in (b"\x1b[A", b"k"):
                cursor = (cursor - 1) % len(items)
            elif key in (b"\x1b[B", b"j"):
                cursor = (cursor + 1) % len(items)
            elif key == b" ":
                checked[cursor] = not checked[cursor]
            elif key in (b"\r", b"\n"):
                return [i for i, c in enumerate(checked) if c]
            elif key in (b"q", b"\x1b"):
                return None
            else:
                continue
            render(first=False)
    except KeyboardInterrupt:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


# The instructions live in a file of their own, which init owns and can
# update; the project's AGENTS.md only points at it. The pointer is a sentence
# so any agent follows it, and its @path makes Claude Code import the file.
AGENT_INSTRUCTIONS_FILE = ".humangate/AGENTS.md"
AGENT_INSTRUCTIONS_POINTER = (
    "Some actions need the person at the host - signing commits, pushing and the like; "
    f"see @{AGENT_INSTRUCTIONS_FILE} for how to ask for them.\n"
)
AGENT_INSTRUCTIONS = """# Actions that need the person (humangate)

Some things can't be done from this sandbox - signing commits or pushing, for example - because
the keys stay on the host. Ask the person to run them with humangate:

- `humangate tools` lists what can be requested and how to use each tool.
- `humangate request --reason "<why>" <tool> [<arg>...]` asks for it and waits for the person's
  decision (up to 9 minutes), then prints the tool's output and exits with its exit code.
- Write the reason for the person reviewing it: what you did and why the tool is needed now.
- Don't work around a rejection. If the person replies with a message instead (exit code 5),
  act on it.
- The person guards some files - the tools, git hooks and config, and whatever
  `.humangate/guard` lists. After you change one, requests are refused until they accept the
  change, so say what you changed and why in your next reason.
- If nobody answers, `humangate ping` tells whether the person is running `humangate loop`.
"""


def instructions_file(worktree):
    # AGENTS.md (read by most agents) unless the project only has a CLAUDE.md
    # of its own - one that doesn't just import AGENTS.md.
    claude = os.path.join(worktree, "CLAUDE.md")
    if not os.path.exists(os.path.join(worktree, "AGENTS.md")) and os.path.exists(claude):
        with open(claude) as f:
            if "@AGENTS.md" not in f.read():
                return "CLAUDE.md"
    return "AGENTS.md"


def read_text(path):
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return f.read()


def instructions_status(worktree):
    body = read_text(os.path.join(worktree, AGENT_INSTRUCTIONS_FILE))
    doc = read_text(os.path.join(worktree, instructions_file(worktree))) or ""
    if body is None or f"@{AGENT_INSTRUCTIONS_FILE}" not in doc:
        return "new" if body in (None, AGENT_INSTRUCTIONS) else "differs"
    return "same" if body == AGENT_INSTRUCTIONS else "differs"


def write_instructions(worktree, force):
    """Writes .humangate/AGENTS.md (keeping an edited one unless force) and
    points the project's AGENTS.md at it. Returns what changed, for display."""
    changes = []
    body_path = os.path.join(worktree, AGENT_INSTRUCTIONS_FILE)
    body = read_text(body_path)
    if body != AGENT_INSTRUCTIONS and (body is None or force):
        os.makedirs(os.path.dirname(body_path), exist_ok=True)
        with open(body_path, "w") as f:
            f.write(AGENT_INSTRUCTIONS)
        changes.append(f"{'updated' if body else 'added'} {AGENT_INSTRUCTIONS_FILE}")
    elif body != AGENT_INSTRUCTIONS:
        changes.append(f"kept your {AGENT_INSTRUCTIONS_FILE} - it differs (--force to replace it)")

    doc = instructions_file(worktree)
    doc_path = os.path.join(worktree, doc)
    text = read_text(doc_path) or ""
    if f"@{AGENT_INSTRUCTIONS_FILE}" not in text:
        with open(doc_path, "w") as f:
            f.write((text.rstrip("\n") + "\n\n" if text.strip() else "") + AGENT_INSTRUCTIONS_POINTER)
        changes.append(f"pointed {doc} at it")
    return changes


GUARD_HEADER = """\
# Files `humangate loop` guards on top of the built-in ones - its tools, this
# file, git hooks and the repository's git config: whatever the tools run or
# read, which the agent could change. One path or glob per line, relative to
# the project root; a directory covers everything in it. The loop shows a
# change as a diff and refuses requests until the person accepts it.
"""
# What init suggests guarding, when the project has it: files that build
# tools, task runners, CI and the shell run as code.
GUARD_CANDIDATES = [
    "package.json", ".npmrc", ".yarnrc.yml", "Makefile", "justfile", "Justfile", "Taskfile.yml",
    "Rakefile", "Gemfile", "pyproject.toml", "setup.py", "noxfile.py", "tox.ini", "Cargo.toml",
    "build.rs", ".cargo/", ".mise.toml", "mise.toml", ".envrc", ".pre-commit-config.yaml",
    ".husky/", "lefthook.yml", ".github/workflows/", ".gitlab-ci.yml", ".gitmodules",
]


def guard_suggestions(worktree):
    """(whether the guard file exists, suggested entries it doesn't list yet)."""
    text = read_text(os.path.join(worktree, GUARD_FILE))
    listed = {entry.strip("/") for entry in guard_entries(text)}
    found = [c for c in GUARD_CANDIDATES if os.path.lexists(os.path.join(worktree, c.rstrip("/")))]
    return text is not None, [c for c in found if c.strip("/") not in listed]


def write_guard(worktree):
    """Creates the guard file, or adds the suggestions it's missing - never
    removes an entry. Returns what changed, for display, or None."""
    exists, missing = guard_suggestions(worktree)
    if exists and not missing:
        return None
    path = os.path.join(worktree, GUARD_FILE)
    text = read_text(path) or GUARD_HEADER
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        # Below the header, a blank line; after existing entries, none.
        f.write(text.rstrip("\n") + "\n" + ("" if exists else "\n") + "".join(e + "\n" for e in missing))
    listed = ", ".join(missing) or "nothing found to suggest yet"
    return f"{'added to' if exists else 'created'} {GUARD_FILE}: {listed}"


def cmd_init(argv):
    flags = {"--force", "--instructions", "--guard"}
    unknown = [a for a in argv if a not in flags]
    if unknown:
        usage(f"unknown argument {', '.join(unknown)}")
    force = "--force" in argv
    add_instructions = "--instructions" in argv
    add_guard = "--guard" in argv
    worktree = worktree_root()

    if not add_instructions and not add_guard:
        if not sys.stdin.isatty():
            usage("name what to add, e.g. `humangate init --instructions --guard`")
        exists, missing = guard_suggestions(worktree)
        label = f"files to guard ({GUARD_FILE})"
        if missing:
            label += f": {', '.join(missing)}"
        items = [
            (
                "--instructions",
                f"instructions for the agent ({AGENT_INSTRUCTIONS_FILE}, referenced from {instructions_file(worktree)})",
                instructions_status(worktree),
            ),
            ("--guard", label, "new" if missing or not exists else "same"),
        ]
        notes = {"new": "", "same": dim(" (already added)"), "differs": dim(" (yours differs - kept unless --force)")}
        picked = checklist(
            "Set up this project",
            [(label + notes[state], state == "new") for _, label, state in items],
        )
        if picked is None:
            print("Nothing added.")
            return EXIT_CANCELLED
        chosen = [items[i][0] for i in picked]
        add_instructions = "--instructions" in chosen
        add_guard = "--guard" in chosen
        print()

    files_changed = []
    if add_guard:
        change = write_guard(worktree)
        print(f"guard: {change or 'already there'}")
        if change:
            files_changed.append(GUARD_FILE)
    if add_instructions:
        changes = write_instructions(worktree, force)
        print(f"instructions: {'; '.join(changes) or 'already there'}")
        if any(c.startswith(("added", "updated")) for c in changes):
            files_changed.append(AGENT_INSTRUCTIONS_FILE)
        if any(c.startswith("pointed") for c in changes):
            files_changed.append(instructions_file(worktree))

    if files_changed:
        listed = ", ".join(files_changed[:-1]) + " and " + files_changed[-1] if len(files_changed) > 1 else files_changed[0]
        review = " A running `humangate loop` asks you to review the change." if GUARD_FILE in files_changed else ""
        print(dim(f"\nCommit {listed} so the changes travel with the project.{review}"))
    return 0


COMMANDS = {
    "loop": cmd_loop,
    "init": cmd_init,
    "request": cmd_request,
    "tools": cmd_tools,
    "ping": cmd_ping,
    "wait": cmd_wait,
    "version": lambda argv: print(f"humangate {VERSION}") or 0,
}


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0 if argv else EXIT_USAGE)
    command = COMMANDS.get(argv[0])
    if not command:
        usage(f"unknown command {argv[0]!r}")
    sys.exit(command(argv[1:]))


if __name__ == "__main__":
    main()
